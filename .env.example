# Copy this file to `.env` before running `docker-compose`.

# Database configuration
DB_NAME=cpt202_consultancy
DB_PASSWORD=replace-with-your-mysql-root-password

# Mail configuration
MAIL_PASSWORD=replace-with-your-smtp-password

# JWT configuration
JWT_SECRET=replace-with-a-secret-at-least-32-charac
# Redis configuration (Docker default: use service name `redis`)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=5000ms
ters-long
